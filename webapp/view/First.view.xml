<!-- https://ui5.sap.com/#/api/sap.m.ListItemBase%23controlProperties type NAVIGATION  -->
<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="ui5.walkthrough.controller.First"
    xmlns:f="sap.ui.layout.form" 
    xmlns:l="sap.ui.layout"
>
<Table id="idProductsTable"
		items= '{sweetModel>/SweetShops}'>
		<headerToolbar>
			<OverflowToolbar>
				<content>
					<Title text='Sweet Shops: {sweetModel>/CountSweets}' level="H2"/>
					<ToolbarSpacer />
					
				</content>
			</OverflowToolbar>
		</headerToolbar>
		<columns>
			<Column  width="12em">
				<Text text="ID" />
			</Column>
			<Column  width="12em">
				<Text text="Name" />
			</Column>
		</columns>

			<items>
			<ColumnListItem vAlign="Middle" type="Navigation" press="onListItemPress">
				<cells>
					
					<Text
						text="{sweetModel>ID}" />
					<Text
						text="{sweetModel>Name}" />
					
				</cells>
			</ColumnListItem>
		</items>
	</Table>
    <Button text="{translateableTexts>sayPressMe}" press="onSayHiPress"></Button>
    <Input value="{/recipient/name}"/>
    <l:Grid defaultSpan="XL12 L12 M12 S12">
        <Image id="image1" 
            press="onImagePress"
            src="images/sample.png" width="100px" height="100px" class="sapUiSmallMargin">
            <layoutData>
                <l:GridData 
                    span="L3 M3 S8"
                    linebreak="true"
                />
            </layoutData>
        </Image>
        <Image id="image2" 
            press="onImagePress"
            src="images/sample.png" width="100px" height="100px" class="sapUiSmallMargin" >

            <layoutData>
                <l:GridData 
                    span="L3 M3 S8"
                    linebreak="true"
                />
            </layoutData>
            </Image>
        <f:SimpleForm id="SimpleFormChange354">
            <f:content>
            <Toolbar >
                <content>
                    <Label text="This is radio button text 00"></Label>
                </content>
            </Toolbar>
                <RadioButtonGroup id="rbg1" columns="2" width="100%" class="sapUiMediumMarginBottom" >
                    <RadioButton id="RB1-1" text="Long Option Number 1" />
                    <RadioButton id="RB1-2" text="Option 2" enabled="false" />
                    <RadioButton id="RB1-3" text="Nr. 3" editable="false" />
                    <RadioButton id="RB1-4" text="Long Option 4" />
                    <RadioButton id="RB1-5" text="Option 5" />
                    <RadioButton id="RB1-6" text="Nr. 6" />
                </RadioButtonGroup>
            </f:content>
        </f:SimpleForm>
    </l:Grid>
    
</mvc:View>